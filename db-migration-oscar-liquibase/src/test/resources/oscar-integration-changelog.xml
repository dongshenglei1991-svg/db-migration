<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="oscar-extension-1" author="db-migration">
        <createTable tableName="OSCAR_LB_PARENT">
            <column name="ID" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="CODE" type="char(16)">
                <constraints unique="true" nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="OSCAR_LB_CHILD">
            <column name="ID" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="PARENT_ID" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="ACTIVE" type="boolean" defaultValueBoolean="true"/>
        </createTable>
        <addForeignKeyConstraint constraintName="FK_OSCAR_LB_CHILD_PARENT"
                                 baseTableName="OSCAR_LB_CHILD" baseColumnNames="PARENT_ID"
                                 referencedTableName="OSCAR_LB_PARENT" referencedColumnNames="ID"/>
        <createIndex indexName="IDX_OSCAR_LB_CHILD_PARENT" tableName="OSCAR_LB_CHILD">
            <column name="PARENT_ID"/>
        </createIndex>
    </changeSet>
    <changeSet id="oscar-extension-2" author="db-migration">
        <createView viewName="OSCAR_LB_CHILD_VIEW">
            SELECT ID, PARENT_ID, ACTIVE FROM OSCAR_LB_CHILD
        </createView>
    </changeSet>
    <!-- 验证 autoIncrement：OSCAR 无 identity 语法，通过 OscarBigIntType 映射为 BIGSERIAL（隐式序列） -->
    <changeSet id="oscar-extension-3" author="db-migration">
        <createTable tableName="OSCAR_LB_AUTOINC">
            <column name="ID" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="NAME" type="varchar(50)"/>
        </createTable>
        <insert tableName="OSCAR_LB_AUTOINC">
            <column name="NAME" value="auto-one"/>
        </insert>
        <insert tableName="OSCAR_LB_AUTOINC">
            <column name="NAME" value="auto-two"/>
        </insert>
        <rollback>
            <dropTable tableName="OSCAR_LB_AUTOINC"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
